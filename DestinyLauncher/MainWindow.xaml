<Window x:Class="DestinyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DestinyLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Destiny Launcher" Icon="/DestinyLauncher;component/Assets/destiny-launcher.ico"
        Width="1000" Height="620" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="Transparent" Foreground="{StaticResource Ink}" ResizeMode="CanMinimize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <!-- With glass disabled, WindowChrome passes CornerRadius as the Win32 ellipse diameter.
             Use 36 here to match the visible 18-DIP frame radius and avoid an opaque outer crescent. -->
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="36" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Decode a shared, small source first; Fant resampling then resolves the final DPI size.
             The original full-detail artwork remains unchanged in the banner. -->
        <BitmapImage x:Key="SmallEmblem" UriSource="/DestinyLauncher;component/Assets/experiment/obsidian-gold-v1/destiny-emblem.png" DecodePixelWidth="112" CacheOption="OnLoad"/>
        <Style x:Key="SmallBrandMark" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource SmallEmblem}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" CornerRadius="18" BorderThickness="0" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="TitleBarSurface" CornerRadius="18,18,0,0" BorderBrush="#302B22" BorderThickness="0,0,0,1" Background="#121310">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image x:Name="TitleEmblem" Width="28" Height="28" Style="{StaticResource SmallBrandMark}"/>
                        <TextBlock Text="Destiny Launcher" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TestModeText" Text="DATOS AISLADOS" Foreground="{StaticResource Gold}" FontSize="9" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowControl}" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"><Path Data="{x:Static local:IconGlyphs.Minimize}" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
                        <Button Style="{StaticResource CloseControl}" Click="Close_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"><Path Data="{x:Static local:IconGlyphs.Close}" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#131410" BorderBrush="#302D23" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,18,0,0">
                            <Button x:Name="HomeNav" Tag="Selected" Style="{StaticResource NavItem}" Click="Home_Click" AutomationProperties.Name="Inicio" ToolTip="Inicio">
                                <StackPanel><Path Data="{x:Static local:IconGlyphs.Home}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Inicio" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="InstallationNav" Style="{StaticResource NavItem}" Click="Installation_Click" AutomationProperties.Name="Instalación" ToolTip="Administrar instalación">
                                <StackPanel><Path Data="{x:Static local:IconGlyphs.Cube}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Instalación" FontSize="9" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Style="{StaticResource NavItem}" Click="Settings_Click" AutomationProperties.Name="Ajustes" ToolTip="Ajustes">
                                <StackPanel><Path Data="{x:Static local:IconGlyphs.Settings}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Ajustes" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="SocialLinks" Grid.Row="2" Margin="0,4,0,12">
                            <Border Height="1" Background="{StaticResource Line}" Margin="24,0,24,8"/>
                            <Button x:Name="DiscordLink" Style="{StaticResource SocialButton}" Tag="https://dsc.gg/destiny-dynasty-mc" Click="SocialLink_Click" ToolTip="Discord · Comunidad de Destiny Dynasty" AutomationProperties.Name="Abrir Discord de Destiny Dynasty">
                                <Path Data="{x:Static local:IconGlyphs.Discord}" Width="21" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="YouTubeLink" Style="{StaticResource SocialButton}" Tag="https://www.youtube.com/@destiny_dynasty" Click="SocialLink_Click" ToolTip="YouTube · Canal de Destiny Dynasty" AutomationProperties.Name="Abrir YouTube de Destiny Dynasty">
                                <Path Data="{x:Static local:IconGlyphs.YouTube}" Width="21" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="XLink" Style="{StaticResource SocialButton}" Tag="https://x.com/DestinyDynasty_" Click="SocialLink_Click" ToolTip="X · Novedades de Destiny Dynasty" AutomationProperties.Name="Abrir X de Destiny Dynasty">
                                <Path Data="{x:Static local:IconGlyphs.X}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="TatnikHostLink" Style="{StaticResource SocialButton}" Tag="https://tatnikhost.net/l/crC7CrzY" Click="SocialLink_Click" ToolTip="Tatnik Host · Hosting del servidor" AutomationProperties.Name="Abrir Tatnik Host">
                                <Path Data="{x:Static local:IconGlyphs.TatnikHost}" Width="21" Height="21" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,12" IsHitTestVisible="False">
                            <Image x:Name="SidebarEmblem" Width="40" Height="40" Style="{StaticResource SmallBrandMark}" Opacity=".85"/>
                            <TextBlock x:Name="LauncherVersionText" FontSize="9" Foreground="{StaticResource Subtle}" Opacity=".55" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" x:Name="PageHost">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.Background><ImageBrush ImageSource="/DestinyLauncher;component/Assets/experiment/obsidian-gold-v1/obsidian-texture.png" Opacity=".045" Stretch="UniformToFill"/></Grid.Background>
                    <Grid x:Name="HomeView">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" Focusable="False">
                            <Grid x:Name="Hero" Height="{Binding ViewportHeight, ElementName=HomeScroll}" MinHeight="280" ClipToBounds="True">
                                <Image Source="/DestinyLauncher;component/Assets/Video/reino-poster.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <MediaElement x:Name="HeroVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="UniformToFill" IsMuted="True" Volume="0" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B510100F"/><GradientStop Color="#2010100F" Offset=".6"/><GradientStop Color="#3810100F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1810100F"/><GradientStop Color="#0010100F" Offset=".4"/><GradientStop Color="#C510100F" Offset=".9"/><GradientStop Color="#FF10100F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                <Image x:Name="HeroMark" Width="250" Height="178" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0" Source="/DestinyLauncher;component/Assets/experiment/obsidian-gold-v1/Combination-Mark-Destiny.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <local:NewsCarousel x:Name="News" Width="350" Height="156" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,22"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,28,0" Background="#B5151612" BorderBrush="#4A4130" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                    <TextBlock x:Name="VersionText" Text="Minecraft 1.20.1 · Fabric" Foreground="#D6CDBB" FontSize="10"/>
                                </Border>
                                <StackPanel x:Name="ProfilePanel" Width="234" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,26">
                                    <Button x:Name="ProfileButton" Click="Profile_Click" Padding="13,12" MinHeight="78" HorizontalContentAlignment="Stretch" Background="#ED181916" BorderBrush="#625239" ToolTip="Editar tu nombre de jugador" AutomationProperties.Name="Editar nombre de jugador">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                            <Border Width="44" Height="48" Background="#29271E" BorderBrush="#665232" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center">
                                                <Grid Margin="4"><TextBlock x:Name="PlayerInitial" Text="D" FontFamily="{StaticResource DisplayFont}" FontSize="23" Foreground="{StaticResource GoldBright}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="PlayerHead" Visibility="Collapsed" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="PlayerNameText" Text="Añadir nombre" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel x:Name="PlayerAccountType" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed"><Image Source="{x:Static local:MicrosoftBrand.Symbol}" Width="12" Height="12" Margin="0,0,5,0"/><TextBlock Text="Microsoft" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></StackPanel>
                                            <Path x:Name="ProfileActionGlyph" Grid.Column="2" Data="{x:Static local:IconGlyphs.Edit}" Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Gold}" StrokeThickness="1.3" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        <Border x:Name="LaunchPanel" Grid.Row="1" BorderBrush="#49402F" BorderThickness="0,1,0,0" Margin="28,0,28,18" Padding="0,16,0,0">
                            <Grid x:Name="LaunchLayout">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel x:Name="InstallSummary" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="EditionText" Text="Destiny" Style="{StaticResource SectionTitle}"/><Border Margin="12,0,0,0" Padding="7,3" Background="#23251F" CornerRadius="4" VerticalAlignment="Center"><TextBlock x:Name="PackStateText" Text="Sin instalar" FontSize="10" Foreground="{StaticResource Muted}"/></Border></StackPanel>
                                    <WrapPanel Margin="0,9,0,0">
                                        <TextBlock Text="Instalada  " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PackInstalledVersionText" FontSize="11" Margin="0,0,20,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Disponible  " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PackLatestVersionText" FontSize="11" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                    </WrapPanel>
                                    <Button x:Name="ManageInstallationButton" Click="Installation_Click" Content="Administrar instalación →" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource GoldBright}" BorderThickness="0" Padding="0,5" MinHeight="28" Margin="0,5,0,0" FontSize="11"/>
                                </StackPanel>
                                <StackPanel x:Name="ActionPanel" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="PrimaryButton" Style="{StaticResource GoldButton}" Height="54" Click="Primary_Click" AutomationProperties.Name="Acción principal">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PrimaryLabel" Text="INSTALAR" FontSize="14" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><Path x:Name="ActionArrow" Grid.Column="1" Data="{x:Static local:IconGlyphs.Arrow}" Width="15" Height="15" Stretch="Uniform" Stroke="#4A3519" StrokeThickness="1.5" Margin="12,0,0,0"/></Grid>
                                    </Button>
                                    <Button x:Name="GameOptionsButton" Grid.Column="1" Width="48" Height="54" Margin="8,0,0,0" Padding="0" Click="GameOptions_Click" ToolTip="Opciones del juego" AutomationProperties.Name="Opciones del juego">
                                        <Path Data="M3 6h18 M3 12h18 M3 18h18" Width="18" Height="14" Stretch="Fill" Stroke="{StaticResource GoldBright}" StrokeThickness="1.6"/>
                                    </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="InstallationView" Visibility="Collapsed" Margin="28,24,28,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Instalación" FontFamily="{StaticResource DisplayFont}" FontSize="28"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12">
                                <Hyperlink x:Name="MoreInstallationOptions" Click="MoreInstallationOptions_Click" Foreground="{StaticResource Muted}" AutomationProperties.Name="Más opciones de instalación">Más opciones</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid x:Name="InstallationContent" Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid x:Name="EditionGrid" MaxHeight="310" Width="508" HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Once">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="DestinyButton" GroupName="Edition" Style="{StaticResource EditionOption}" Tag="Destiny" Click="Edition_Click" AutomationProperties.Name="Destiny, experiencia completa">
                                            <RadioButton.Background><ImageBrush Stretch="UniformToFill" AlignmentY="Top"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/Modpacks/destiny-v1.jpg" DecodePixelWidth="600"/></ImageBrush.ImageSource></ImageBrush></RadioButton.Background>
                                            <StackPanel VerticalAlignment="Bottom"><TextBlock x:Name="DestinyTitle" Text="Destiny" FontFamily="{StaticResource DisplayFont}" FontSize="26" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DestinyState" FontSize="11" Foreground="{StaticResource GoldBright}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LiteButton" Grid.Column="2" GroupName="Edition" Style="{StaticResource EditionOption}" Tag="DestinyLite" Click="Edition_Click" AutomationProperties.Name="Destiny Lite, alternativa ligera">
                                            <RadioButton.Background><ImageBrush Stretch="UniformToFill" AlignmentY="Top"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/Modpacks/lite-v1.jpg" DecodePixelWidth="600"/></ImageBrush.ImageSource></ImageBrush></RadioButton.Background>
                                            <StackPanel VerticalAlignment="Bottom"><TextBlock x:Name="LiteTitle" Text="Destiny Lite" FontFamily="{StaticResource DisplayFont}" FontSize="26" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LiteState" FontSize="11" Foreground="#CFC8B8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </RadioButton>
                                    <RadioButton x:Name="StaffButton" Grid.Column="4" GroupName="Edition" Style="{StaticResource EditionOption}" Tag="DestinyStaff" Click="Edition_Click" Visibility="Collapsed" AutomationProperties.Name="Destiny Staff">
                                        <RadioButton.Background><ImageBrush Stretch="UniformToFill" AlignmentY="Top"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/Modpacks/staff-v1.jpg" DecodePixelWidth="600"/></ImageBrush.ImageSource></ImageBrush></RadioButton.Background>
                                        <StackPanel VerticalAlignment="Bottom"><TextBlock x:Name="StaffTitle" Text="Destiny Staff" FontFamily="{StaticResource DisplayFont}" FontSize="26" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StaffState" FontSize="11" Foreground="#CFC8B8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </RadioButton>
                                </Grid>
                                <Border x:Name="InstallationDetails" Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,14,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <WrapPanel Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Text, ElementName=EditionText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,16,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,16,4"><TextBlock Text="Instalada  " FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Text, ElementName=PackInstalledVersionText}" MaxWidth="120" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,4"><TextBlock Text="Disponible  " FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Text, ElementName=PackLatestVersionText}" MaxWidth="120" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel>
                                        </WrapPanel>
                                            <TextBlock x:Name="InstallationPathText" Grid.Row="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,14,0"/>
                                            <Button x:Name="OpenInstallationFolderButton" Grid.Column="1" Grid.RowSpan="2" Padding="10,8" Click="OpenInstallationFolder_Click" ToolTip="Abrir carpeta del juego" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Abrir carpeta de la variante seleccionada">
                                                <StackPanel Orientation="Horizontal"><Path Data="{x:Static local:IconGlyphs.Folder}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/><TextBlock Text="Abrir carpeta" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel>
                                            </Button>
                                    </Grid>
                                </Border>
                        </Grid>
                        <Grid x:Name="InstallationActions" Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="Volver a Inicio" Click="Home_Click" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/>
                            <Button x:Name="InstallPrimaryButton" Grid.Column="1" MinWidth="210" Height="46" Style="{StaticResource GoldButton}" Click="Primary_Click"><TextBlock Text="{Binding Text, ElementName=PrimaryLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="Bold" FontSize="13"/></Button>
                        </Grid>
                    </Grid>
                    <ContentControl x:Name="SettingsPageHost" Visibility="Collapsed"/>
                    <Border x:Name="StatusFooter" Grid.Row="1" Background="#161713" BorderBrush="#302D24" BorderThickness="0,1,0,0">
                        <Grid>
                            <ProgressBar x:Name="Progress" VerticalAlignment="Top" Height="3" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>
                            <Grid Margin="26,14,26,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource Gold}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="Preparando launcher" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusDetail" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                <Button x:Name="RetryCheckButton" Grid.Column="2" Content="Comprobar" Click="RetryCheck_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <!-- Paint over full-bleed surfaces: a transparent border gutter would expose the black HWND backing. -->
            <Grid x:Name="WindowOutline" Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle x:Name="OutlineTop" Height="1" VerticalAlignment="Top"/>
                <Rectangle x:Name="OutlineBottom" Height="1" VerticalAlignment="Bottom"/>
                <Rectangle x:Name="OutlineLeft" Width="1" HorizontalAlignment="Left"/>
                <Rectangle x:Name="OutlineRight" Width="1" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>

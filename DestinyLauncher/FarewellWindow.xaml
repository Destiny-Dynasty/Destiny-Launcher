<Window x:Class="DestinyLauncher.FarewellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destiny Launcher" Width="600" Height="390" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="#10100F" Foreground="#F5F1E6"
        Icon="/DestinyLauncher;component/Assets/destiny-launcher.ico">
    <Border BorderBrush="#625239" BorderThickness="1" Background="#10100F">
        <Grid>
            <Image Source="/DestinyLauncher;component/Assets/Video/reino-poster.jpg" Stretch="UniformToFill" Opacity=".28"/>
            <Border Background="#B510100F"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="470">
                <Image Source="/DestinyLauncher;component/Assets/experiment/obsidian-gold-v1/destiny-emblem.png" Width="78" Height="78" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Hasta pronto" FontFamily="Georgia" FontSize="30" Foreground="#F5F1E6" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Text="Destiny Launcher se ha desinstalado. Gracias por formar parte de nuestra aventura." TextAlignment="Center" TextWrapping="Wrap" Foreground="#CFC8B8" FontSize="13" Margin="0,14,0,0"/>
                <TextBlock Text="Las puertas de Destiny siempre estarán abiertas para ti." TextAlignment="Center" Foreground="#D7B779" FontSize="12" Margin="0,9,0,0"/>
                <Button Content="CERRAR" Style="{StaticResource GoldButton}" Height="42" Width="160" Margin="0,26,0,0" Click="Close_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

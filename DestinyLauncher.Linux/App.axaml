<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DestinyLauncher.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DestinyLauncher.Linux/DestinyStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="Background" Value="#10110F" />
      <Setter Property="Foreground" Value="#F5F1E6" />
    </Style>
  </Application.Styles>
</Application>
